# Copia questo file in `.env` e compila i valori per il tuo ambiente.
#
# ── PRODUZIONE (deploy) ───────────────────────────────────
#   NODE_ENV=production
#   TRUST_PROXY=1                        # dietro il proxy di Railway/Render
#   DB_HOST/PORT/USER/PASSWORD/NAME      # dal DB gestito (Neon)
#   DB_SSL=true                          # Neon impone SSL
#   JWT_SECRET / JWT_REFRESH             # NUOVI, lunghi e casuali
#   JWT_ISSUER=https://<be>.up.railway.app
#   JWT_AUDIENCE=https://<fe>.vercel.app
#   CORS_ORIGIN=https://<fe>.vercel.app  # dominio esatto del FE, https

# ── Server ────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
# TRUST_PROXY=1               # numero di hop se dietro reverse proxy

# ── Database ──────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=infopoint
DB_PASSWORD=infopoint
DB_NAME=infopoint_sardinia
DB_DIALECT=postgres
DB_LOGGING=false
# DB_SSL: true per DB gestiti (Neon, ecc.) che impongono connessione cifrata.
DB_SSL=false

# ── JWT ───────────────────────────────────────────────────
JWT_SECRET=change_me_with_a_long_random_string
JWT_REFRESH=change_me_with_another_long_random_string
JWT_ISSUER=http://localhost:3000
JWT_AUDIENCE=http://localhost:4200

# ── CORS / Frontend ───────────────────────────────────────
CORS_ORIGIN=http://localhost:4200
# API_BASE_URL=https://api.example.com   # primo server in Swagger (staging/prod)

# ── Admin seed (operatore unico) ──────────────────────────
# Usate dal seeder per creare l'admin iniziale.
ADMIN_EMAIL=admin@infopoint.sardegna.it
ADMIN_PASSWORD=ChangeMe_123!
ADMIN_NAME=Admin

# ── Sorgenti dati esterne ─────────────────────────────────
# Open-Meteo: nessuna chiave necessaria.
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
# EFFIS / Copernicus (incendi). Host JRC; layer hotspot ercc.hs_24hrs_point.
EFFIS_BASE_URL=https://ies-ows.jrc.ec.europa.eu
# NASA FIRMS — sorgente incendi primaria (EFFIS fallback). MAP_KEY gratuita:
# https://firms.modaps.eosdis.nasa.gov/api/map_key
FIRMS_MAP_KEY=
# Più satelliti VIIRS uniti (uno solo può non avere passaggi → 0 focolai).
# FIRMS_SOURCES=VIIRS_NOAA20_NRT,VIIRS_NOAA21_NRT,VIIRS_SNPP_NRT
# Finestra storica in giorni (l'area API di FIRMS accetta solo 1..5).
# FIRMS_DAY_RANGE=5
# Protezione Civile / ARPAS (allagamenti/allerte). Feed da verificare.
PROTEZIONE_CIVILE_FEED_URL=

# ── Traffico aereo: OpenSky Network (gratis, OAuth2) ──────
OPENSKY_BASE_URL=https://opensky-network.org/api
# OAuth2 client_credentials (dal JSON scaricato dall'account OpenSky).
# Vuote = accesso anonimo (limiti più bassi).
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
# OPENSKY_TOKEN_URL=https://auth.opensky-network.org/auth/realms/opensky-network/protocol/openid-connect/token

# ── Traffico marittimo: aisstream.io (gratis, WebSocket) ──
# Senza API key il collector AIS resta inattivo e /vessels torna available:false.
AISSTREAM_API_KEY=
# AISSTREAM_URL=wss://stream.aisstream.io/v0/stream
# AISSTREAM_MAX_AGE_MS=3600000   # età max posizione nave prima di scartarla

# ── Traffico stradale: TomTom Traffic (free tier) ─────────
# Senza API key /traffic torna available:false.
TOMTOM_API_KEY=
# TOMTOM_BASE_URL=https://api.tomtom.com

# ── Cache TTL (secondi) ───────────────────────────────────
CACHE_TTL_WEATHER=900
CACHE_TTL_FIRES=600
CACHE_TTL_FLOODS=600
CACHE_TTL_NEWS=900
CACHE_TTL_FLIGHTS=60
CACHE_TTL_TRAFFIC=120

# ── Feed RSS news (CSV: nome|url, separati da virgola) ─────
# Default ragionevoli in src/constants/sources.constants.js se omessa.
# NEWS_FEEDS=ANSA Sardegna|https://...,Unione Sarda|https://...
